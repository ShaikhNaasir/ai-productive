# Shared env for `docker compose up` (local dev stack).
# Copy to .env.docker and fill in the AI keys. DB URLs are set in docker-compose.yml.

# Shared secret between server and ai-service (any string, must match on both).
INTERNAL_API_KEY=dev-internal-key

# Auth
JWT_SECRET=dev-jwt-secret-change-me

# AI (leave blank to run without AI; core features still work)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Semantic search (optional)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDINGS_ENABLED=false
