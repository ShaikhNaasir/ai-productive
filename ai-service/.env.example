# FastAPI ai-service configuration

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-8"
ANTHROPIC_FAST_MODEL="claude-haiku-4-5-20251001"
EMBEDDING_MODEL="voyage-3"          # embeddings provider model (Voyage recommended for Anthropic stack)
VOYAGE_API_KEY="pa-..."             # only needed for semantic search (Phase 10)

# Database (pgvector) — same Postgres as the server
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Server-to-server auth: must match the server's INTERNAL_API_KEY
INTERNAL_API_KEY="shared-secret-between-server-and-ai-service"

PORT=8000
