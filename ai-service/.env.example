# FastAPI ai-service configuration

# LLM provider — configure ANY ONE of the three and generation features work.
# LLM_PROVIDER picks which to use: "auto" (default) tries anthropic > openai > gemini
# by whichever key is present; or force one with "anthropic" | "openai" | "gemini".
LLM_PROVIDER="auto"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-8"
ANTHROPIC_FAST_MODEL="claude-haiku-4-5-20251001"

# OpenAI (alternative provider)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini (alternative provider)
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-2.0-flash"

# Embeddings (semantic search only) — stays Voyage; the DB vector column is 1024-dim.
EMBEDDING_MODEL="voyage-3"          # embeddings provider model (Voyage recommended for Anthropic stack)
VOYAGE_API_KEY="pa-..."             # only needed for semantic search (Phase 10)

# Database (pgvector) — same Postgres as the server
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Server-to-server auth: must match the server's INTERNAL_API_KEY
INTERNAL_API_KEY="shared-secret-between-server-and-ai-service"

PORT=8000
