# Express API configuration

# PostgreSQL / Supabase connection string.
# Supabase: Project Settings > Database > Connection string (use the pooled "Transaction" URI for serverless,
# or the direct 5432 URI for migrations). Prisma needs both:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# AI service (server-to-server)
AI_SERVICE_URL="http://localhost:8000"
INTERNAL_API_KEY="shared-secret-between-server-and-ai-service"
# Request timeout to the AI service, and one retry on cold start / transient failure.
# Defaults suit Render free-tier spin-up (services sleep when idle).
AI_TIMEOUT_MS="60000"
AI_RETRY_DELAY_MS="1500"
# Max AI calls per user per 15 min (throttles paid LLM endpoints).
AI_RATE_LIMIT_MAX="60"

# Google Calendar sync (Roadmap C1) — optional; leave blank to disable the integration.
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console, enable the
# Calendar API, and add the redirect URI below to the client's authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"
# Background two-way sync interval in ms (default 300000 = 5 min).
GOOGLE_SYNC_INTERVAL_MS="300000"

# Admin panel (Roadmap D) — comma-separated allowlist of emails that bootstrap as
# admins on register/login. Leave blank to have no admins. Set your real address
# here locally and in the host's env; do NOT commit a real address (this repo is public).
ADMIN_EMAILS=""

# SaaS billing (Roadmap D5) — Razorpay. Optional; leave blank to disable checkout
# (plan-gating still runs off the User.plan column and core CRUD is unaffected).
# Create a Razorpay account, a subscription Plan (copy its plan_id), and a webhook
# pointing at <api-url>/api/billing/webhook (with a secret you set here).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID=""
