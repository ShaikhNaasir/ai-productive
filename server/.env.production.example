# Production environment for the Express API.
# Copy to .env on the production host (or set as platform env vars).

NODE_ENV=production
PORT=4000

# Production database (Supabase / managed Postgres with pgvector)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Strong random secret in production
JWT_SECRET="CHANGE_ME_long_random_value"
JWT_EXPIRES_IN="7d"

# Deployed client origin (for CORS)
CLIENT_ORIGIN="https://your-client.vercel.app"

# AI service
AI_SERVICE_URL="https://your-ai-service.onrender.com"
INTERNAL_API_KEY="CHANGE_ME_shared_secret"

# Enable semantic search only if pgvector + Voyage key are configured
EMBEDDINGS_ENABLED="true"
