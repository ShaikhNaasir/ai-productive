// Prisma schema — AI-Powered Personal Productivity Assistant
// Database: PostgreSQL (Supabase) with the pgvector extension for semantic search.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ShareRole {
  VIEW
  EDIT
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum Plan {
  FREE
  PAID
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  // Bumped on logout / password change to invalidate previously issued JWTs
  // (the token carries this version and is rejected once it no longer matches).
  tokenVersion Int        @default(0)
  // Email verification (Roadmap E1). A new account starts unverified; a hashed,
  // expiring token is emailed and cleared on verify. Admins are auto-verified.
  emailVerified       Boolean   @default(false)
  emailVerifyTokenHash String?
  emailVerifyExpires   DateTime?
  // Two-factor auth (Roadmap E2, TOTP). `pending` holds the secret between setup and
  // the confirming code; on enable it moves to `secret`. Backup codes are stored
  // hashed and consumed single-use.
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret         String?
  twoFactorPendingSecret  String?
  twoFactorBackupCodes    String[] @default([])
  // Admin panel (Roadmap D). role gates /api/admin/*; a DISABLED account is
  // rejected everywhere and cannot log in.
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  // SaaS tier (Roadmap D5). Everyone is FREE by default; PAID is granted by a
  // Razorpay subscription webhook (or an admin). `planRenewsAt` is the current
  // billing period end — access is treated as expired once it passes.
  plan         Plan       @default(FREE)
  planRenewsAt DateTime?
  // Razorpay linkage + last-seen subscription status (created/active/halted/
  // cancelled/…). Null until the user starts a checkout. Never a secret.
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  subscriptionStatus     String?
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tasks         Task[]
  notes         Note[]
  schedules     Schedule[]
  reminders     Reminder[]
  focusSessions FocusSession[]
  habits        Habit[]
  habitLogs     HabitLog[]
  taskShares    TaskShare[]
  aiUsage       AiUsage[]
  googleAccount GoogleAccount?

  @@map("users")
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  recurrence  Recurrence @default(NONE)
  dueDate     DateTime?
  tags        String[]   @default([])
  completedAt DateTime?
  // Subtasks (Roadmap A1): self-relation. A subtask points at its parent; deleting
  // a parent cascades to its subtasks.
  parentId    String?
  // Semantic search embedding (Phase 10). 1024 dims = Voyage-3.
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  focusSessions FocusSession[]
  shares      TaskShare[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([parentId])
  @@map("tasks")
}

// Task sharing (Roadmap C2). Grants another user view or edit access to a task.
// Unique per (task, user); deleting either side removes the share.
model TaskShare {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  role      ShareRole @default(VIEW)
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_shares")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @default("")
  category  String?
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  embedding Unsupported("vector(1024)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pinned])
  @@map("notes")
}

model Schedule {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  // All-day event (no meaningful time-of-day). Tracked so a Google all-day event
  // round-trips as `start.date` instead of being rewritten as a midnight timestamp.
  allDay      Boolean   @default(false)
  // Google Calendar sync (Roadmap C1.2): id of the linked Google event. Null for
  // app-only schedules; set once the schedule is pushed to / imported from Google.
  googleEventId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
  @@index([googleEventId])
  @@map("schedules")
}

// Google Calendar OAuth connection (Roadmap C1). One per user. Stores the refresh
// token (long-lived) so the server can mint access tokens for background two-way
// sync. `syncToken` is reserved for incremental sync in a later slice.
model GoogleAccount {
  id           String    @id @default(uuid())
  userId       String    @unique
  refreshToken String
  accessToken  String?
  expiryDate   DateTime?
  calendarId   String    @default("primary")
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

// Pomodoro / time-tracking session (Roadmap A3). A session is opened on start
// and closed on stop, when `seconds` is computed from the timestamps. Deleting a
// task detaches its sessions (SetNull) so tracked time stays counted in totals.
model FocusSession {
  id        String    @id @default(uuid())
  userId    String
  taskId    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  seconds   Int       @default(0)
  // Planned duration (Roadmap A3 / focus robustness). Lets a reload recover a
  // running timer and caps recorded time so an orphaned open session can't inflate.
  plannedSeconds Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
  @@map("focus_sessions")
}

// Habit tracking (Roadmap B2). A habit accrues one HabitLog per day it is
// checked in; streaks are computed from those logs. Deleting a habit cascades
// to its logs.
model Habit {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  userId    String
  // The UTC day (midnight) this check-in counts for. Unique per habit per day.
  date      DateTime
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId])
  @@map("habit_logs")
}

// AI usage & cost monitoring (Roadmap C3). One row per AI call, attributed to
// the user who triggered it, with token counts and estimated USD cost.
model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  endpoint     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

model Reminder {
  id        String   @id @default(uuid())
  userId     String
  message    String
  remindAt   DateTime
  sent       Boolean    @default(false)
  recurrence Recurrence @default(NONE)
  taskId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([remindAt])
  // The scheduler's hot query filters sent + remindAt together; a lone `sent` index
  // is near-useless since the column is overwhelmingly true once reminders age out.
  @@index([sent, remindAt])
  @@map("reminders")
}

// Razorpay webhook ledger (Roadmap D5). One row per delivered event, keyed by the
// provider's event id so a redelivered webhook is processed at most once
// (idempotency). No FK: the row is an immutable audit fact, kept even if the user
// is later deleted.
model BillingEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  type            String
  userId          String?
  payload         Json?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("billing_events")
}

// Append-only trail of admin moderation actions (Roadmap D3). No FK to users so a
// row survives a hard-deleted target/admin; ids are kept as plain strings.
model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}
