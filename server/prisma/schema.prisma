// Prisma schema — AI-Powered Personal Productivity Assistant
// Database: PostgreSQL (Supabase) with the pgvector extension for semantic search.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tasks        Task[]
  notes        Note[]
  schedules    Schedule[]
  reminders    Reminder[]

  @@map("users")
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  recurrence  Recurrence @default(NONE)
  dueDate     DateTime?
  tags        String[]   @default([])
  completedAt DateTime?
  // Subtasks (Roadmap A1): self-relation. A subtask points at its parent; deleting
  // a parent cascades to its subtasks.
  parentId    String?
  // Semantic search embedding (Phase 10). 1024 dims = Voyage-3.
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([parentId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @default("")
  category  String?
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  embedding Unsupported("vector(1024)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pinned])
  @@map("notes")
}

model Schedule {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
  @@map("schedules")
}

model Reminder {
  id        String   @id @default(uuid())
  userId     String
  message    String
  remindAt   DateTime
  sent       Boolean    @default(false)
  recurrence Recurrence @default(NONE)
  taskId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([remindAt])
  @@index([sent])
  @@map("reminders")
}
